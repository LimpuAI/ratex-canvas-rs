/// echodawn:canvas 共享绘制词汇表 v2.1(canvas-drawing-plugins spec T16,
/// design D9:字段增量 —— 词汇表封闭纪律不破,新增字段 ≠ 开放词汇表)。
///
/// v2.1 变更(相对 2.0.0,单版本就地升位,不做兼容层):
/// - `layer-opts`:层不透明度 / 混合模式 / 层裁剪(host: opacity/clip 经
///   StateStack 层包裹实现;blend 为 offscreen 层合成落地前的**语义预留**,
///   宿主诚实降级 warn + 按普通层渲染)
/// - `draw-cmd.fill-gradient-along`:沿路径弧长渐变填充(宿主
///   `fill_path_gradient_along` 分段近似渲染)
/// - 双侧同步纪律:四个 provider 域与 widget 同步 re-vendor + 重发布构件
///   (旧构件经 introspect 门禁以结构化诊断拒绝——这是设计行为)
package echodawn:canvas@2.1.0;

interface draw {
    // ---- Tier 2 参数动画(与 2.0.0 逐字段一致;定义单源在本包) ----
    enum anim-property {
        opacity,
        translate-x,
        translate-y,
        scale,
        rotate,
        stroke-width,
        color,
    }
    enum loop-mode { once, loop, ping-pong }
    record keyframe { t: f32, value: f32, easing: string }
    record anim-desc {
        property: anim-property,
        keyframes: list<keyframe>,
        duration-ms: u32,
        delay-ms: u32,
        loop: loop-mode,
        alt-color: option<string>,
    }

    // ---- 无损绘制描述(与 2.0.0 逐字段一致) ----
    record font-desc {
        family: option<string>,
        weight: option<u16>,
        italic: bool,
        features: option<list<string>>,
    }
    record gradient-stop { pos: f64, color: string }
    record linear-gradient { x0: f64, y0: f64, x1: f64, y1: f64, stops: list<gradient-stop> }
    variant paint { solid(string), gradient(linear-gradient) }
    record shadow-desc {
        offset-x: f64,
        offset-y: f64,
        blur: f64,
        spread: f64,
        color: string,
        alpha: f64,
        width: f64,
        height: f64,
        rotation: f64,
    }
    record draw-cmd {
        cmd-type: string,
        params: list<f64>,
        fill: option<paint>,
        stroke: option<paint>,
        stroke-width: option<f64>,
        corner-radius: option<f64>,
        corner-radii: option<tuple<f64, f64, f64, f64>>,
        dash: option<list<f64>>,
        line-cap: option<string>,
        shadow: option<shadow-desc>,
        text-content: option<string>,
        font: option<font-desc>,
        group-depth: u32,
        id: option<u32>,
        anims: list<anim-desc>,
        /// v2.1:沿路径弧长渐变填充(pos ∈ [0,1] 弧长参数;color 与 paint
        /// 同源解析)。仅 path 指令消费;与 fill 同存时优先
        fill-gradient-along: option<list<gradient-stop>>,
    }

    // ---- v2.1:混合模式闭集(宿主 BlendMode 家族子集) ----
    enum blend-mode { normal, screen, lighter, multiply, overlay, soft-light }

    /// v2.1:层级绘制选项
    record layer-opts {
        /// 层不透明度(0-1;None = 1)
        opacity: option<f64>,
        /// 层混合模式(缺省 normal;offscreen 合成落地前宿主 warn + normal 渲染)
        blend: option<blend-mode>,
        /// 层裁剪 [x, y, w, h](px;None = 不裁剪)
        clip: option<tuple<f64, f64, f64, f64>>,
    }

    record layer {
        kind: string,
        dirty: bool,
        z-index: u32,
        commands: list<draw-cmd>,
        /// v2.1:层级绘制选项(缺省全 None = 普通层)
        opts: option<layer-opts>,
    }

    // ---- 声明式 hover 效果(与 2.0.0 逐字段一致) ----
    record hover-effect {
        kind: string,
        params: list<f64>,
    }
}
